# Auth -- choose one mode, never both
OIDC_ENABLED=true
OIDC_CONFIG_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BASE_URL=
JWT_SIGNING_KEY=

# Or use bearer token instead of OIDC
# MCP_API_KEY=

# SMTP relay (optional overrides, defaults: localhost:25)
# SMTP_HOST=
# SMTP_PORT=
# MAIL_FROM=

# Tegami v2
# Comma-separated recipient allowlist. Unset: any recipient is accepted (startup warning).
TEGAMI_ALLOWED_RECIPIENTS=you@example.com,other@example.com
# Comma-separated OWNER/REPO:PATH_PREFIX pairs for body_ref. Unset: every body_ref fails with E_REF_NOT_ALLOWED.
TEGAMI_REF_ALLOWLIST=OWNER/REPO:digests/
# Fine-grained PAT with Contents: read on the allowlisted repos only.
TEGAMI_GITHUB_TOKEN=github_pat_REPLACE_ME
# Byte limit for inline bodies and fetched body_ref content.
TEGAMI_MAX_BODY_BYTES=262144
# Timeout for the GitHub contents request, in seconds.
TEGAMI_REF_TIMEOUT_S=10
